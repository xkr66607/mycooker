# ============================================================
# 复制此文件为 .env，然后填入你自己的 Key
#     copy .env.example .env
# ============================================================
#
# ⚠️ 先理解一件事：模型分三块，能力不同，不能随便互换
#
#     对话 CHAT_*        → 千问 / DeepSeek / 任意 OpenAI 兼容服务   ✅ 随便换
#     视觉 VISION_*      → 千问 qwen-vl / GPT-4o 等                只能换有视觉能力的
#     向量 EMBEDDING_*   → 千问 text-embedding-v4 / OpenAI 等      只能换有 embedding 的
#
#     DeepSeek 实测：/embeddings 返回 404，没有向量接口，也没有多模态模型。
#     所以「对话可以换 DeepSeek，向量和视觉必须留在千问」。
#
# ============================================================


# ------------------------------------------------------------
# 千问（DashScope）—— 向量和视觉一直用它，不要动
# 控制台：https://bailian.console.aliyun.com/
# Key 格式：sk- 开头，35 个字符
# ------------------------------------------------------------
DASHSCOPE_API_KEY=sk-你的千问Key
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1


# ------------------------------------------------------------
# 1. 对话模型
# ------------------------------------------------------------
# 【方案 A：用千问】什么都不用填，自动继承上面的 DASHSCOPE_*
#     CHAT_MODEL=qwen-plus
#
# 【方案 B：通过千问调用 DeepSeek】只改模型名，不填 CHAT_BASE_URL
#     CHAT_MODEL=deepseek-v4.1-flash      （日常，推理模型）
#     CHAT_MODEL=deepseek-v4-pro          （更强，推理模型，不支持看图）
#
# 【方案 C：走 DeepSeek 官方 API】三个都要填
#     CHAT_API_KEY=sk-你的DeepSeekKey
#     CHAT_BASE_URL=https://api.deepseek.com
#     CHAT_MODEL=deepseek-chat            （官方叫法，和千问上不一样！）
#
# ⚠️ 最容易踩的坑：两家平台的模型命名不同
#     千问 DashScope 上  → deepseek-v4.1-flash / deepseek-v4-pro
#     DeepSeek 官方 API  → deepseek-chat / deepseek-reasoner
#    混着填会得到 404「The model xxx does not exist」。
CHAT_MODEL=qwen-plus


# ------------------------------------------------------------
# 2. 视觉模型（识别食材照片）
# ------------------------------------------------------------
# 实测（2026-11，账号内 182 个模型）：
#   ✘ qwen-vl-plus / qwen-vl-max   已下线，返回 404
#   ✔ qwen3-vl-plus                当前主力，识别一张图只花 29 个 token  ← 推荐
#   ✔ qwen-vl-ocr                  偏文字识别场景
#   △ deepseek-v4.1-flash          能看图，但它是推理模型，
#                                  看一张图要烧 1400~5200 个思考 token，
#                                  成本是千问的 40~180 倍，不建议拿来做视觉
VISION_MODEL=qwen3-vl-plus


# ------------------------------------------------------------
# 3. 向量模型（检索的地基）
# ------------------------------------------------------------
# ⚠️ 换这个 = 向量维度/语义空间全变 = 旧知识库作废，必须清空重传文档。
#    没有特殊理由不要改。
#    另外 DeepSeek 官方 API 没有 embedding 接口（/embeddings 返回 404），
#    向量只能留在千问。
EMBEDDING_MODEL=text-embedding-v4
# 可选维度：1024（默认）/ 768 / 512，越大越精细但越慢越贵
# EMBEDDING_DIM=1024


# ------------------------------------------------------------
# 服务
# ------------------------------------------------------------
HOST=127.0.0.1
PORT=8001


# ------------------------------------------------------------
# 可选：token 上限（推理模型的思考也算在里面，别调太小）
# ------------------------------------------------------------
# CHAT_MAX_TOKENS=3000
# VISION_MAX_TOKENS=8000


# ------------------------------------------------------------
# 可选：用独立 Key（不填就自动继承 DASHSCOPE_*）
# ------------------------------------------------------------
# EMBEDDING_API_KEY=sk-另一个千问Key
# VISION_API_KEY=sk-另一个千问Key


# ------------------------------------------------------------
# 可选：Agent 模式
# ------------------------------------------------------------
# 默认开启。模型自己决定查不查、查几次、查什么。
# 设为 0 就退回老做法：固定检索一次，模型被动接收。
# 两种模式都能跑，可以用同一批问题对比效果。
# MYCOOKER_AGENT=1

# 步数上限（保险丝，不是性能参数）。
# 模型有可能反复查同一个词、或者揪着报错的工具不放，一路调下去。
# 没有这个上限，一个问题就可能烧掉一整天额度。
# 实测正常问题 1~2 轮就够，6 已经非常宽松。
# MYCOOKER_AGENT_MAX_STEPS=6

# Agent 每轮输出上限。推理模型每轮都要先思考，所以比普通对话给得多。
# MYCOOKER_AGENT_MAX_TOKENS=4000

# 单次工具结果送进上下文的字符上限。
# 工具返回整篇菜谱会撑爆上下文，而且模型读不过来 —— 它只要关键数字。
# MYCOOKER_AGENT_MAX_TOOL_CHARS=2500

# ------------------------------------------------------------
# 可选：问题复杂度路由
# ------------------------------------------------------------
# 默认开启。按问题难度自动分派三条路：
#   chat  —— 闲聊，不检索，一次模型调用
#   rag   —— 单跳事实，检索一次，一次模型调用
#   agent —— 计算 / 列举 / 多诉求 / 做法请求，工具循环
#
# 为什么要分派：Agent 在单跳题上要多付一次模型调用
# （先决定查什么，再根据结果作答），比 RAG 慢一倍。
# 判断全用规则，不调模型 —— 用模型判断"这题难不难"本身又要一次调用。
#
# 设为 0 就所有问题都走 MYCOOKER_AGENT 指定的那一种，方便做对比实验。
# MYCOOKER_ROUTER=1

# 检索一条都没命中时，是否改走 Agent 再找一次。
#
# 默认 0（关）。这是实测之后的决定：Agent 面对的是同一个知识库，
# 那里没有的东西换个查法还是没有。对「量子力学的波函数坍缩是什么」，
# 升级后 Agent 连工具都没调，只是说"这不是厨房问题"，还多花了 2.6 秒。
#
# 现在的做法是：0 命中时把知识库清单塞进上下文，让模型告诉用户
# "我这儿有这 6 道菜"，让他自己换问法。查本地库，不花网络往返。
#
# 留着这个开关是为了换更大的知识库之后再测一次，看结论还成不成立。
# MYCOOKER_RAG_ESCALATE=0

# ------------------------------------------------------------
# 可选：网络
# ------------------------------------------------------------
# 是否让请求走系统代理（Windows 注册表里那个）。
#
# 默认关闭。DashScope 是国内服务，不需要代理。
# requests 会自动读取 Windows 代理设置，实测走代理后向量化慢 4 倍
# 而且会偶发 RemoteDisconnected，一次卡 25 秒，用户看到的是白屏。
#
# 如果你的网络环境必须走代理才能访问 DashScope，设为 1。
# MYCOOKER_USE_PROXY=0

# 向量化的超时（秒）和重试次数。
#
# 这两个数字直接决定用户能白屏多久：
#   原来 60 秒 × 3 次 = 最坏 180 秒，比"报错"还糟 —— 用户不知道发生了什么。
#   现在 10 秒 × 2 次 = 最坏 20 秒，而且超时会降级成"不检索"继续答。
# 向量化在用户提问后的第一秒就要跑，它卡住等于整个对话卡住。
# MYCOOKER_EMBEDDING_TIMEOUT=10
# MYCOOKER_EMBEDDING_RETRIES=2