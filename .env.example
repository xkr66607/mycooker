# ============================================================
# 复制此文件为 .env，然后填入你自己的 Key
#     copy .env.example .env
# ============================================================

# ---- 阿里云百炼（DashScope）----
# 控制台：https://bailian.console.aliyun.com/
# 格式形如 sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx（约 35 个字符）
DASHSCOPE_API_KEY=

# 官方兼容模式地址，一般不用改
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1

# ---- 模型选择 ----
# 对话：qwen-plus（性价比） / qwen-max（更强） / qwen-turbo（更快）
CHAT_MODEL=qwen-plus

# 图片识别（上传食材照片用）
VISION_MODEL=qwen-vl-plus

# 向量：text-embedding-v4
EMBEDDING_MODEL=text-embedding-v4

# ---- 可选：联网兜底（当前版本未接入，留空即可）----
# TAVILY_API_KEY=

# ---- 服务 ----
HOST=127.0.0.1
PORT=8001