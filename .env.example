# ============================================================
# 复制此文件为 .env，然后填入你自己的 Key
#     copy .env.example .env
# ============================================================
#
# ⚠️ 先理解一件事：模型分三块，能力不同，不能随便互换
#
#     对话 CHAT_*        → 千问 / DeepSeek / 任意 OpenAI 兼容服务   ✅ 随便换
#     视觉 VISION_*      → 千问 qwen-vl / GPT-4o 等                只能换有视觉能力的
#     向量 EMBEDDING_*   → 千问 text-embedding-v4 / OpenAI 等      只能换有 embedding 的
#
#     DeepSeek 实测：/embeddings 返回 404，没有向量接口，也没有多模态模型。
#     所以「对话可以换 DeepSeek，向量和视觉必须留在千问」。
#
# ============================================================


# ------------------------------------------------------------
# 千问（DashScope）—— 向量和视觉一直用它，不要动
# 控制台：https://bailian.console.aliyun.com/
# Key 格式：sk- 开头，35 个字符
# ------------------------------------------------------------
DASHSCOPE_API_KEY=sk-你的千问Key
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1


# ------------------------------------------------------------
# 1. 对话模型
# ------------------------------------------------------------
# 【方案 A：用千问】什么都不用填，自动继承上面的 DASHSCOPE_*
#     CHAT_MODEL=qwen-plus
#
# 【方案 B：通过千问调用 DeepSeek】只改模型名，不填 CHAT_BASE_URL
#     CHAT_MODEL=deepseek-v4.1-flash      （日常，推理模型）
#     CHAT_MODEL=deepseek-v4-pro          （更强，推理模型，不支持看图）
#
# 【方案 C：走 DeepSeek 官方 API】三个都要填
#     CHAT_API_KEY=sk-你的DeepSeekKey
#     CHAT_BASE_URL=https://api.deepseek.com
#     CHAT_MODEL=deepseek-chat            （官方叫法，和千问上不一样！）
#
# ⚠️ 最容易踩的坑：两家平台的模型命名不同
#     千问 DashScope 上  → deepseek-v4.1-flash / deepseek-v4-pro
#     DeepSeek 官方 API  → deepseek-chat / deepseek-reasoner
#    混着填会得到 404「The model xxx does not exist」。
CHAT_MODEL=qwen-plus


# ------------------------------------------------------------
# 2. 视觉模型（识别食材照片）
# ------------------------------------------------------------
# 实测（2026-11，账号内 182 个模型）：
#   ✘ qwen-vl-plus / qwen-vl-max   已下线，返回 404
#   ✔ qwen3-vl-plus                当前主力，识别一张图只花 29 个 token  ← 推荐
#   ✔ qwen-vl-ocr                  偏文字识别场景
#   △ deepseek-v4.1-flash          能看图，但它是推理模型，
#                                  看一张图要烧 1400~5200 个思考 token，
#                                  成本是千问的 40~180 倍，不建议拿来做视觉
VISION_MODEL=qwen3-vl-plus


# ------------------------------------------------------------
# 3. 向量模型（检索的地基）
# ------------------------------------------------------------
# ⚠️ 换这个 = 向量维度/语义空间全变 = 旧知识库作废，必须清空重传文档。
#    没有特殊理由不要改。
#    另外 DeepSeek 官方 API 没有 embedding 接口（/embeddings 返回 404），
#    向量只能留在千问。
EMBEDDING_MODEL=text-embedding-v4
# 可选维度：1024（默认）/ 768 / 512，越大越精细但越慢越贵
# EMBEDDING_DIM=1024


# ------------------------------------------------------------
# 服务
# ------------------------------------------------------------
HOST=127.0.0.1
PORT=8001


# ------------------------------------------------------------
# 可选：token 上限（推理模型的思考也算在里面，别调太小）
# ------------------------------------------------------------
# CHAT_MAX_TOKENS=3000
# VISION_MAX_TOKENS=8000


# ------------------------------------------------------------
# 可选：用独立 Key（不填就自动继承 DASHSCOPE_*）
# ------------------------------------------------------------
# EMBEDDING_API_KEY=sk-另一个千问Key
# VISION_API_KEY=sk-另一个千问Key